---
/**
 * Eigene Zeichnung des Kreisels (D2.7) nach OpenStreetMap-Geometrie
 * (scripts/map/build-map.ts). Linien asphalt, Garage orange, Beschriftung als Text.
 * Keine eingebettete Karte, nichts wird von außen geladen.
 */
import map from '@/data/map.json';
import type { Dict } from '@/i18n';

interface Props {
  t: Dict;
  /** Breite/Höhe, z. B. 1.6 für 16:10 im Hero */
  ratio?: number;
  label: string;
  attribution?: boolean;
  class?: string;
}
const { t, ratio, label, attribution = true, class: cls } = Astro.props;
const W = map.width;
const fullH = map.height;
const H = ratio ? Math.min(fullH, W / ratio) : fullH;
const y0 = ratio ? Math.max(0, Math.min(fullH - H, 190 - H / 2)) : 0;
const rb = map.roundabout!;
const [gx, gy] = map.garageCenter;
const aral = map.aral;
const L = t.access.labels;
const widths: Record<string, number> = { major: 11, secondary: 8, minor: 5, service: 3 };
---
<figure class:list={['rmap', cls]}>
  <svg viewBox={`0 ${y0} ${W} ${H}`} role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
    <rect x="0" y={y0} width={W} height={H} fill="#fff" />
    <g fill="none" stroke="#AEB2B5" stroke-width="9" stroke-linecap="round">
      {map.river.map((d) => <path d={d} />)}
    </g>
    <g fill="none" stroke="#45484B" stroke-linecap="round" stroke-linejoin="round">
      {
        [...map.roads]
          .sort((a, b) => widths[a.cls] - widths[b.cls])
          .map((r) => <path d={r.d} stroke-width={widths[r.cls]} />)
      }
      <circle cx={rb.cx} cy={rb.cy} r={rb.r} stroke-width="11" />
    </g>
    <circle cx={rb.cx} cy={rb.cy} r={rb.r - 7} fill="#fff" />
    <g fill="none" stroke="#000" stroke-width="1.5" stroke-dasharray="7 5">
      {map.rail.map((d) => <path d={d} />)}
    </g>
    <path d={map.garage} fill="#E95D0C" stroke="#000" stroke-width="1.5" />
    {aral && <rect x={aral[0] - 5} y={aral[1] - 5} width="10" height="10" fill="#000" />}
    <g class="lbl">
      <text x={gx - 30} y={gy + 34} text-anchor="middle" class="strong">{L.garage}</text>
      {aral && <text x={aral[0] - 10} y={aral[1] - 8} text-anchor="end">{L.aral}</text>}
      <text x="10" y="192" text-anchor="start">{L.ettelbruck}</text>
      <text x="490" y="322" text-anchor="end">{L.diekirch}</text>
      <text x="326" y={Math.max(y0 + 18, 20)} text-anchor="start">N27</text>
      <text x="92" y="186" text-anchor="start" class="small">N7</text>
      <text x="420" y="246" text-anchor="middle" class="small">Rue du Viaduc</text>
      <text x="78" y="104" text-anchor="start" class="small">{L.sure}</text>
    </g>
  </svg>
  {attribution && <figcaption class="t-small t-muted">{t.access.osmLabel}: {t.access.osm}</figcaption>}
</figure>

<style>
  .rmap { margin: 0; }
  svg { width: 100%; height: auto; display: block; border: 1.5px solid var(--color-black); }
  .lbl text { font-family: var(--font-sans); font-size: 13px; font-weight: 600; fill: #000; paint-order: stroke; stroke: #fff; stroke-width: 4px; stroke-linejoin: round; }
  .lbl .strong { font-family: var(--font-wide); font-stretch: 112%; font-weight: 800; font-size: 14px; }
  .lbl .small { font-size: 11px; fill: #45484b; }
  figcaption { margin-top: 8px; }
</style>
