---
/**
 * Logo der Garage als Vektor (aus umrondpoint-NEW.pdf vom Kunden, Okt. 2026: „Um Rondpoint –
 * Garage - Carrosserie“). Das SVG steht direkt im HTML, damit das Kreisel-„O“ (Gruppe .logo-o)
 * beim ersten Laden einmal dreht (C7.1, global.css) und beim Hover noch einmal.
 * tone="light": weiße Schrift für dunkle Flächen (Footer).
 */
import logoDark from '@/assets/brand/logo.svg?raw';
import logoLight from '@/assets/brand/logo-light.svg?raw';

interface Props {
  href: string;
  label: string;
  class?: string;
  tone?: 'dark' | 'light';
}
const { href, label, class: cls, tone = 'dark' } = Astro.props;
---
<a href={href} class:list={['logo', `logo-${tone}`, cls]}>
  <span class="logo-svg" set:html={tone === 'light' ? logoLight : logoDark} />
  <span class="sr-only">, {label}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; min-height: 48px; text-decoration: none; }
  .logo-svg { display: block; width: 158px; }
  .logo-svg :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .logo :global(.logo-o) { transform-box: fill-box; transform-origin: center; transition: rotate 900ms var(--ease-in-out); }
  /* Kreisel-„O“ dreht sich beim Hover einmal */
  @media (prefers-reduced-motion: no-preference) { .logo:hover :global(.logo-o) { rotate: 360deg; } }
  .logo-light .logo-svg { width: 180px; }
  @media (max-width: 22.4375rem) { .logo-dark .logo-svg { width: 128px; } }
  @media (min-width: 64rem) { .logo-dark .logo-svg { width: 224px; } }
</style>
