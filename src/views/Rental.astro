---
/** Vermietung (D3): voller Finder, Flottentabelle, Bedingungen, Miet-FAQ, Formular F1. */
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import FinderSection from '@/components/finder/FinderSection.astro';
import FleetTable from '@/components/finder/FleetTable.astro';
import Faq, { type FaqKey } from '@/components/Faq.astro';
import RentalForm from '@/components/forms/RentalForm.astro';
import { hasContent, hasOpenPoint, isUnconfirmed, rich, stripOpenPoints, useT } from '@/i18n';
import { path, type Lang } from '@/i18n/config';
import { getFleet } from '@/lib/fleet.server';
import { fleetView } from '@/lib/fleet-view';
import ContentSections from '@/components/ContentSections.astro';
import { breadcrumbs, faqPage, rentalService } from '@/lib/jsonld';
import { presentation, showOpenPoints, site } from '@/lib/site';
import { photo } from '@/lib/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const p = t.pages.rental;
const fleet = await getFleet(lang);
const items = fleetView(fleet, lang, t);
const crumbs = [
  { name: t.nav.home, href: path(lang, 'home') },
  { name: t.nav.rental, href: path(lang, 'rental') },
];
const faqKeys: FaqKey[] = ['permis', 'carte', 'prix', 'louer', 'reserver'];
const visibleFaq = presentation ? faqKeys.filter((k) => !isUnconfirmed(t.faq.items[k].a) && hasContent(t.faq.items[k].a)) : faqKeys;
const jsonld = [
  breadcrumbs(crumbs.map((c) => ({ name: c.name, url: c.href }))),
  rentalService({ name: p.h1, serviceType: t.nav.rental, url: path(lang, 'rental'), items: fleet }),
  faqPage(
    faqKeys
      .map((k) => t.faq.items[k])
      .filter((it) => !hasOpenPoint(it.a))
      .map((it) => ({ q: it.q, a: stripOpenPoints(it.a) })),
  ),
];
---
<Base lang={lang} route={{ page: 'rental' }} title={t.seo.rental.title} description={t.seo.rental.description} jsonld={jsonld}>
  <PageIntro
    crumbLabel={t.nav.breadcrumb}
    crumbs={crumbs}
    h1={p.h1}
    lead={!site.confirmations.rentalDurations && showOpenPoints ? `${p.lead} ${p.durationsMissing}` : p.lead}
    photo={photo('rental')}
    photoAlt={t.photos.rental}
  />

  <FinderSection lang={lang} t={t} id="flotte" />

  <section class="section tone" aria-labelledby="table-h">
    <div class="wrap">
      <h2 id="table-h">{t.fleetTable.h2}</h2>
      {items.length ? <FleetTable t={t} items={items} /> : <p set:html={rich(t.finder.empty)} />}
    </div>
  </section>

  <ContentSections t={t} lang={lang} sections={t.content.rental.sections} />

  {
    showOpenPoints && (
      <section class="section cond" aria-labelledby="cond-h">
        <div class="wrap">
          <h2 id="cond-h">{p.conditionsH2}</h2>
          <p class="prose-w" set:html={rich(p.conditionsMissing)} />
        </div>
      </section>
    )
  }

  <Faq t={t} keys={visibleFaq} heading={t.faq.rentalH2} id="faq-location" />

  <section class="section form-sec" aria-labelledby="form-h" id="demande-location">
    <div class="wrap">
      <h2 id="form-h">{p.formH2}</h2>
      <p class="prose-w">{p.formIntro}</p>
      <RentalForm lang={lang} t={t} fleet={fleet} />
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 16px; padding: 8px 0 48px; }
  .intro h1, .intro p { margin: 0; }
  h2 { margin: 0 0 24px; }
  .cond, .form-sec { border-top: 1.5px solid var(--color-black); }
  .form-sec p { margin: 0 0 32px; }
</style>
