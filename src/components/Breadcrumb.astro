---
interface Props {
  label: string;
  items: { name: string; href: string }[];
}
const { label, items } = Astro.props;
---
<nav class="crumbs t-small" aria-label={label}>
  <ol>
    {
      items.map((it, i) => (
        <li>
          {i === items.length - 1 ? (
            <span aria-current="page">{it.name}</span>
          ) : (
            <a href={it.href}>{it.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs { padding-block: 16px; color: var(--color-asphalt); }
  ol { display: flex; flex-wrap: wrap; gap: 4px 0; list-style: none; margin: 0; padding: 0; }
  li { display: inline-flex; align-items: center; min-height: 32px; }
  li + li::before { content: '/'; margin: 0 10px; color: var(--color-asphalt); }
  a { color: var(--color-black); }
  span[aria-current] { color: var(--color-asphalt); }
</style>
