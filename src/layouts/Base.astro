---
/**
 * Grundlayout: <html lang>, Title/Description, Canonical, hreflang (5 + x-default),
 * Open Graph/Twitter, JSON-LD, Schrift-Preload, Skip-Link, Header, Footer, Kontaktleiste.
 */
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ContactBar from '@/components/ContactBar.astro';
import { useT } from '@/i18n';
import { alternates as alts, HREFLANG, HTML_LANG, pathFor, withBase, type Lang, type Route } from '@/i18n/config';
import { organization, SITE_ORIGIN } from '@/lib/jsonld';
import { presentation, site } from '@/lib/site';

interface Props {
  lang: Lang;
  route: Route;
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: { src: string; width: number; height: number; alt: string };
  jsonld?: Record<string, unknown>[];
  contactBar?: { askHref?: string; whatsappText?: string };
  isHome?: boolean;
}
const { lang, route, title, description, noindex = false, ogImage, jsonld = [], contactBar = {}, isHome = false } =
  Astro.props;
const t = useT(lang);
const alternates = alts(route);
const canonical = new URL(pathFor(lang, route), SITE_ORIGIN).toString();
const og = ogImage ?? { src: withBase(presentation ? '/og/rondpoint-demo.png' : '/og/rondpoint.png'), width: 1200, height: 630, alt: t.meta.ogAlt };
const ogUrl = new URL(og.src, SITE_ORIGIN).toString();
const OG_LOCALE: Record<Lang, string> = { fr: 'fr_LU', de: 'de_LU', lb: 'lb_LU', en: 'en_GB', pt: 'pt_PT' };
const ld = [organization(), ...jsonld];
// Hinweis oben (im Dashboard ein- und ausschalten), sonst französischer Text
const notice = (site as { notice?: { active?: boolean } & Partial<Record<Lang, string>> }).notice;
const noticeText = notice?.active ? (notice[lang]?.trim() || notice.fr?.trim() || '') : '';
---
<!doctype html>
<html lang={HTML_LANG[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || presentation) && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {
      !noindex &&
        alternates.map((a) => (
          <link rel="alternate" hreflang={HREFLANG[a.lang]} href={new URL(a.href, SITE_ORIGIN).toString()} />
        ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternates.find((a) => a.lang === 'lb')!.href, SITE_ORIGIN).toString()}
        />
      )
    }
    <link rel="preload" href={withBase('/fonts/archivo-var.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {
      isHome && (
        <script is:inline>
          try{if(document.referrer&&new URL(document.referrer).origin===location.origin)document.documentElement.setAttribute('data-seen','')}catch(e){}
        </script>
      )
    }
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/\u00AD/g, '').replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    {noticeText && <p class="site-notice" role="status">{noticeText}</p>}
    <Header lang={lang} t={t} alternates={alternates} current={route.page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} t={t} alternates={alternates} />
    <ContactBar t={t} askHref={contactBar.askHref} whatsappText={contactBar.whatsappText} />
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
