---
/** F1 Mietanfrage (type=location). Vorbelegung aus ?remorque=&permis=&objet= */
import FormShell from './FormShell.astro';
import type { Dict } from '@/i18n';
import type { Lang } from '@/i18n/config';
import type { FleetItem } from '@/lib/fleet';

interface Props {
  lang: Lang;
  t: Dict;
  fleet: FleetItem[];
  preselect?: string;
}
const { lang, t, fleet, preselect } = Astro.props;
const f = t.forms;
const r = f.rental;
const id = 'demande';
---
<FormShell type="location" lang={lang} t={t} id={id} submit={r.submit}>
  <input type="hidden" name="cargo" value="" />
  <input type="hidden" name="vehicleName" value="" data-vehicle-name />
  <div class="fg">
    <label class="field-label" for={`${id}-vehicle`}>{r.vehicle}</label>
    {fleet.length === 0 && <span class="field-hint">{r.noFleet}</span>}
    <select class="field" id={`${id}-vehicle`} name="vehicle" required data-msg-required={f.errors.vehicle}>
      <option value="">{f.choose}</option>
      {
        fleet.map((i) => (
          <option value={i.id} selected={preselect === i.id}>
            {i.name}
          </option>
        ))
      }
      <option value="autre">{r.other}</option>
    </select>
  </div>
  <div class="row pair">
    <div class="fg">
      <label class="field-label" for={`${id}-from`}>{r.from}</label>
      <input
        class="field"
        id={`${id}-from`}
        name="from"
        type="date"
        required
        data-not-past
        data-msg-required={f.errors.from}
        data-msg-past={f.errors.past}
      />
    </div>
    <div class="fg">
      <label class="field-label" for={`${id}-to`}>{r.to}</label>
      <input
        class="field"
        id={`${id}-to`}
        name="to"
        type="date"
        required
        data-not-past
        data-after="from"
        data-msg-required={f.errors.to}
        data-msg-past={f.errors.past}
        data-msg-order={f.errors.toBeforeFrom}
      />
    </div>
  </div>
  <div class="fg">
    <label class="field-label" for={`${id}-licence`}>{r.licence} <span class="opt">({f.optional})</span></label>
    <select class="field" id={`${id}-licence`} name="licence">
      <option value="">{r.licenceNone}</option>
      <option value="B">{r.licenceB}</option>
      <option value="B96">{r.licenceB96}</option>
      <option value="BE">{r.licenceBE}</option>
    </select>
  </div>
  <div class="fg">
    <label class="field-label" for={`${id}-message`}>{f.message} <span class="opt">({f.optional})</span></label>
    <textarea class="field" id={`${id}-message`} name="message" rows="4" maxlength="3000"></textarea>
  </div>
</FormShell>
