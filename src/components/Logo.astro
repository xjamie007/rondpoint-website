---
/**
 * Originallogo der Garage (von rondpoint.lu, Wix-Rastergrafik, freigestellt).
 * Das Kreisel-„O" liegt als eigene Ebene darüber (class="logo-o") und dreht sich
 * beim ersten Laden der Startseite einmal um 360° (C7.1). Mit Vektorlogo später austauschen.
 */
import { Image } from 'astro:assets';
import logoBase from '@/assets/brand/logo-base.png';
import logoO from '@/assets/brand/logo-o.png';
import logoLight from '@/assets/brand/logo-light.png';

interface Props {
  href: string;
  label: string;
  class?: string;
  tone?: 'dark' | 'light';
}
const { href, label, class: cls, tone = 'dark' } = Astro.props;
// Lage des ersten „O" im Logo (in Prozent, aus der Freistellung gemessen)
const O = { left: 9.402, top: 34.324, width: 13.932 };
---
<a href={href} class:list={['logo', `logo-${tone}`, cls]}>
  {
    tone === 'light' ? (
      <Image src={logoLight} alt="Um Rondpoint Garage" widths={[240, 360, 480]} sizes="180px" loading="lazy" class="logo-img" />
    ) : (
      <span class="logo-stack">
        <Image src={logoBase} alt="Um Rondpoint Garage" widths={[200, 300, 400, 560]} sizes="(min-width: 1024px) 224px, 158px" loading="eager" class="logo-img" />
        <Image
          src={logoO}
          alt=""
          widths={[48, 72, 96]}
          sizes="28px"
          loading="eager"
          class="logo-o"
          style={`left:${O.left}%;top:${O.top}%;width:${O.width}%`}
        />
      </span>
    )
  }
  <span class="sr-only">, {label}</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; min-height: 48px; text-decoration: none; }
  .logo-stack { position: relative; display: block; width: 158px; }
  .logo-img { display: block; width: 100%; height: auto; }
  .logo-stack :global(.logo-o) { position: absolute; height: auto; transition: rotate 900ms var(--ease-in-out); }
  /* Kreisel-„O“ dreht sich beim Hover einmal */
  @media (prefers-reduced-motion: no-preference) { .logo:hover .logo-stack :global(.logo-o) { rotate: 360deg; } }
  .logo-light { width: 180px; }
  .logo-light :global(.logo-img) { width: 180px; }
  @media (max-width: 22.4375rem) { .logo-stack { width: 128px; } }
  @media (min-width: 64rem) { .logo-stack { width: 224px; } }
</style>
