---
/**
 * Nur funktionale Symbole (C2): Telefon, WhatsApp, Menü, Schließen, Galerie-Pfeile,
 * Häkchen, Warnzeichen, Fragezeichen, Pfeil; dazu Leistungs-Piktogramme für die Leiste der Startseite.
 * Eigene Zeichnungen, 2 px Strich.
 */
interface Props {
  name: 'phone' | 'whatsapp' | 'menu' | 'close' | 'prev' | 'next' | 'check' | 'warning' | 'question' | 'info' | 'expand' | 'arrow' | 'trailer' | 'car' | 'wrench' | 'tag' | 'mower' | 'spray';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 24, class: cls, label } = Astro.props;
const paths: Record<Props['name'], string> = {
  phone:
    'M6.5 3.5h3l1.5 4.5-2 1.3a11.5 11.5 0 0 0 5.7 5.7l1.3-2 4.5 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z',
  whatsapp:
    'M3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 8 19.3l-4.5 1.2ZM9 8.5c0 3.6 2.9 6.5 6.5 6.5l1-1.6-2.2-1-1 .9a4.5 4.5 0 0 1-2.6-2.6l.9-1-1-2.2L9 8.5Z',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  prev: 'M15 5l-7 7 7 7',
  next: 'M9 5l7 7-7 7',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  warning: 'M12 3.5 2.5 20h19L12 3.5ZM12 10v4.5M12 17.5v.01',
  question:
    'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.9-.9 1.5v.7M12 16.8v.01',
  info: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 11v5.5M12 7.8v.01',
  expand: 'M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5',
  arrow: 'M4 12h16M14 6l6 6-6 6',
  trailer: 'M2.5 6.5h13v9h-13ZM15.5 13h6M21.5 11.5v3M8 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z',
  car: 'M3.5 16.5v-4l2.2-5h12.6l2.2 5v4ZM3.5 12.5h17M6.5 16.5v2M17.5 16.5v2M7 14.5h1.5M15.5 14.5H17',
  wrench: 'M20.5 6.8a4.5 4.5 0 0 1-6.2 5.4l-7.6 7.6a2 2 0 0 1-2.8-2.8l7.6-7.6a4.5 4.5 0 0 1 5.4-6.2L14 6l.8 3.2L18 10Z',
  tag: 'M3.5 3.5h8l9 9-8 8-9-9ZM8 8h.01',
  mower: 'M3.5 14.5h12l1.5-4H6ZM17 10.5l3.5-7M7 19a2 2 0 1 1-4 0 2 2 0 0 1 4 0ZM17 19a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z',
  spray: 'M3.5 9.5h7l2 1.5v2l-2 1.5h-7ZM6.5 14.5v5M12.5 12h2M17 8.5v.01M19 12v.01M17 15.5v.01M20.5 7v.01M20.5 17v.01',
};
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"><path d={paths[name]} /></svg>
