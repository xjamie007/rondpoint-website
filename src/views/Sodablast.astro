---
/** Sodablast (D3): was es ist, Vorher-nachher-Fotos (fehlen), WhatsApp für ein erstes Urteil, Formular. */
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import WorkshopForm from '@/components/forms/WorkshopForm.astro';
import Icon from '@/components/Icon.astro';
import Steps from '@/components/Steps.astro';
import { rich, useT } from '@/i18n';
import { path, type Lang } from '@/i18n/config';
import { breadcrumbs } from '@/lib/jsonld';
import { showOpenPoints, whatsappHref } from '@/lib/site';
import { photo } from '@/lib/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const p = t.pages.sodablast;
const d = t.details.sodablast;
const crumbs = [
  { name: t.nav.home, href: path(lang, 'home') },
  { name: t.services.sodablast.h3, href: path(lang, 'sodablast') },
];
---
<Base
  lang={lang}
  route={{ page: 'sodablast' }}
  title={t.seo.sodablast.title}
  description={t.seo.sodablast.description}
  jsonld={[breadcrumbs(crumbs.map((x) => ({ name: x.name, url: x.href })))]}
>
  <PageIntro crumbLabel={t.nav.breadcrumb} crumbs={crumbs} h1={p.h1} lead={p.lead} photo={photo('sodablast')} photoAlt={t.photos.sodablast} />
  <section class="section block" aria-labelledby="explain-h">
    <div class="wrap split">
      <div>
        <h2 id="explain-h" class="h-bar reveal">{d.explainH2}</h2>
        <p class="t-lead prose-w reveal">{d.explain}</p>
        <p class="prose-w reveal">{d.explain2}</p>
      </div>
      <aside class="use reveal" aria-labelledby="what-h">
        <h3 id="what-h">{p.whatH2}</h3>
        <ul class="plain one">
          {Object.values(p.items).map((i) => <li>{i}</li>)}
        </ul>
      </aside>
    </div>
  </section>
  <section class="section block tone" aria-labelledby="steps-h">
    <div class="wrap">
      <h2 id="steps-h" class="h-bar reveal">{d.processH2}</h2>
      <Steps steps={d.process} />
      <p>
        <a class="btn btn-secondary" href={whatsappHref(p.whatsappText)} rel="noopener">
          <Icon name="whatsapp" size={20} />
          {p.whatsappLink}
        </a>
      </p>
    </div>
  </section>
  {
    showOpenPoints && (
      <section class="section block" aria-labelledby="photos-h">
        <div class="wrap">
          <h2 id="photos-h">{p.photosH2}</h2>
          <p set:html={rich(p.photosMissing)} />
        </div>
      </section>
    )
  }
  <section class="section block" aria-labelledby="form-h">
    <div class="wrap">
      <h2 id="form-h">{p.formH2}</h2>
      <WorkshopForm lang={lang} t={t} preselect="sodablast" />
    </div>
  </section>
</Base>

<style>
  .block { border-top: 1.5px solid var(--color-black); }
  h2 { margin: 0 0 24px; }
  .block p { margin: 0 0 24px; }
  .split { display: grid; gap: 40px; }
  @media (min-width: 64rem) { .split { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 72px; align-items: start; } }
  .use { padding: 28px 24px; background: var(--color-black); color: var(--color-white); border-radius: var(--radius-edge); }
  .use h3 { margin: 0 0 20px; font-size: 1.5rem; font-stretch: 118%; }
  .use .one { grid-template-columns: none; }
</style>
