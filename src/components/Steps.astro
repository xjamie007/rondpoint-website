---
/** Ablauf in Schritten (nur für echte Reihenfolgen). */
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---
<ol class="steps stagger">
  {
    steps.map((s) => (
      <li class="reveal">
        <p>{s}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 0; }
  .steps li {
    counter-increment: step;
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding-bottom: 32px;
  }
  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-edge);
    background: var(--color-orange);
    color: var(--color-black);
    font-weight: 800;
    font-size: 1.25rem;
    font-stretch: 118%;
  }
  /* Verbindungslinie zwischen den Nummern */
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 23.25px;
    top: 48px;
    bottom: 0;
    width: 1.5px;
    background: var(--color-orange);
  }
  .steps p { margin: 0; padding-top: 10px; font-size: 1.125rem; line-height: 1.5; max-width: 52ch; }
</style>
