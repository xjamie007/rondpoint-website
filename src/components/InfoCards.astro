---
/** Erklärende Kacheln einer Leistungsseite: kurze Überschrift + Absatz. Keine Nummern (keine Reihenfolge). */
interface Props {
  items: { h: string; p: string }[];
  /** Überschriftenebene der Kacheln */
  level?: 'h3' | 'h4';
}
const { items, level = 'h3' } = Astro.props;
const H = level;
---
<ul class="cards stagger" role="list">
  {
    items.map((i) => (
      <li class="card reveal">
        <H class="card-h">{i.h}</H>
        <p>{i.p}</p>
      </li>
    ))
  }
</ul>

<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 48rem) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  .card {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px 24px 24px;
    border: 1.5px solid var(--color-black);
    border-radius: var(--radius-edge);
    background: var(--color-white);
    transition: box-shadow var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out);
  }
  .card::before {
    content: '';
    position: absolute;
    top: -1.5px;
    left: 24px;
    width: 48px;
    height: 5px;
    background: var(--color-orange);
    transition: width var(--dur-3) var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover { transform: translateY(-4px); box-shadow: 0 20px 36px -24px rgb(0 0 0 / 0.5); }
    .card:hover::before { width: 96px; }
  }
  .card-h { margin: 0; font-size: 1.3125rem; line-height: 1.25; font-stretch: 112%; }
  .card p { margin: 0; line-height: 1.55; color: var(--color-asphalt); }
</style>
