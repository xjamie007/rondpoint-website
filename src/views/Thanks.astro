---
/** Anfrage angekommen (E7). Ziel der 303-Weiterleitung der Edge Function. noindex. */
import Base from '@/layouts/Base.astro';
import HoursTable from '@/components/HoursTable.astro';
import { rich, useT } from '@/i18n';
import { path, type Lang } from '@/i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const p = t.pages.thanks;
---
<Base lang={lang} route={{ page: 'thanks' }} title={t.seo.thanks.title} description={t.seo.thanks.description} noindex>
  <section class="section">
    <div class="wrap inner">
      <svg class="check" viewBox="0 0 52 52" width="64" height="64" aria-hidden="true">
        <circle cx="26" cy="26" r="24" fill="none" stroke="currentColor" stroke-width="2" />
        <path d="M15 27l7 7 15-15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h1>{p.h1}</h1>
      <p class="t-lead prose-w" set:html={rich(p.text)} />
      <h2 class="h3">{t.access.hoursH3}</h2>
      <HoursTable t={t} />
      <p><a class="btn btn-secondary" href={path(lang, 'home')}>{p.back}</a></p>
    </div>
  </section>
</Base>

<style>
  .inner { display: grid; gap: 24px; justify-items: start; }
  .inner > * { margin: 0; }
  .h3 { font-size: 1.25rem; margin-top: 16px; }
</style>
